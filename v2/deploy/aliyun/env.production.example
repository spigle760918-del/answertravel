NODE_ENV=production
HOST=127.0.0.1
PORT=4288
DATABASE_URL=postgresql://answertravel_runtime:REPLACE_WITH_RUNTIME_PASSWORD@127.0.0.1:5432/answertravel_v2
MIGRATION_DATABASE_URL=postgresql://answertravel_migrator:REPLACE_WITH_MIGRATION_PASSWORD@127.0.0.1:5432/answertravel_v2
REDIS_URL=redis://127.0.0.1:6379/2
LOG_LEVEL=info
DEEPSEEK_API_KEY=INJECT_WITH_SERVER_SECRET_STORE
ACCEPTANCE_TENANT_ID=REPLACE_WITH_APPROVED_TENANT_UUID
WEB_ROOT=/app/web-dist
SOURCE_FETCH_ALLOWED_DOMAINS=
PRODUCT_AUTH_MODE=session
PRODUCT_PUBLIC_ORIGIN=https://REPLACE_WITH_PRODUCT_DOMAIN
PRODUCT_SESSION_COOKIE_NAME=answertravel_session
PRODUCT_SESSION_TTL_HOURS=12
# 仅在当前实例完成真实验收后填写；不得复制旧服务器的通过状态。
# ALIYUN_RUNTIME_EVIDENCE=YYYY-MM-DD：当前实例的数据库、Redis、API、Worker 运行验收摘要
# PUBLIC_HTTPS_EVIDENCE=YYYY-MM-DD：当前实例公网域名与 HTTPS 验收摘要
# CLOUD_BACKUP_RESTORE_EVIDENCE=YYYY-MM-DD：当前实例备份、校验与隔离恢复演练摘要
POSTGRES_DB=answertravel_v2
POSTGRES_ADMIN_USER=REPLACE_WITH_ADMIN_ONLY_FOR_CONTAINER_INIT
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
POSTGRES_RUNTIME_USER=answertravel_runtime
POSTGRES_RUNTIME_PASSWORD=REPLACE_WITH_RUNTIME_SECRET
POSTGRES_MIGRATOR_USER=answertravel_migrator
POSTGRES_MIGRATOR_PASSWORD=REPLACE_WITH_MIGRATOR_SECRET
