server {
    listen 443 ssl http2;
    server_name REPLACE_WITH_ISOLATED_CANDIDATE_DOMAIN;

    # Configure certificate paths through the existing panel/site workflow.
    ssl_certificate     REPLACE_WITH_CERTIFICATE_PATH;
    ssl_certificate_key REPLACE_WITH_PRIVATE_KEY_PATH;

    location / {
        proxy_pass http://172.30.0.11:4288;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
