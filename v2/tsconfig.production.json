  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "src/**/*.ts",
    "contracts/**/*.ts",
    "scripts/migrate.ts",
