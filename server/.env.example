NODE_ENV=development
ANSWERTRAVEL_API_HOST=127.0.0.1
ANSWERTRAVEL_API_PORT=4174
ANSWERTRAVEL_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
ANSWERTRAVEL_DEMO_AUTH=true
ANSWERTRAVEL_STORAGE=json
ANSWERTRAVEL_INVITATION_TTL_MS=604800000
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
ANSWERTRAVEL_SIMULATE_PROVIDER_RESPONSES=true
ANSWERTRAVEL_PROVIDER_TIMEOUT_MS=45000
ANSWERTRAVEL_COLLECTION_MAX_ATTEMPTS=3
ANSWERTRAVEL_COLLECTION_RETRY_BASE_MS=5000
ANSWERTRAVEL_COLLECTION_RETRY_MAX_MS=300000
ANSWERTRAVEL_COLLECTION_SCHEDULER_INTERVAL_MS=60000
ANSWERTRAVEL_COLLECTION_TEAM_MONTHLY_QUOTA=5000
ANSWERTRAVEL_COLLECTION_BRAND_MONTHLY_QUOTA=1000
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_API_ENDPOINT=https://api.search.brave.com/res/v1/web/search
ANSWERTRAVEL_SOURCE_SEARCH_MAX_RESULTS=5
ANSWERTRAVEL_SOURCE_FETCH_TIMEOUT_MS=12000
ANSWERTRAVEL_SOURCE_FETCH_MAX_BYTES=1500000
ANSWERTRAVEL_SOURCE_AUTO_DISCOVER=true

# 生产环境必须切换为 postgres，并关闭演示身份。
# NODE_ENV=production
# ANSWERTRAVEL_STORAGE=postgres
# DATABASE_URL=postgres://answertravel:replace-me@127.0.0.1:5432/answertravel
# ANSWERTRAVEL_DEMO_AUTH=false
# ANSWERTRAVEL_ALLOWED_ORIGINS=https://app.example.com
# ANSWERTRAVEL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# ANSWERTRAVEL_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
