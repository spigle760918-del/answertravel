NODE_ENV=production
HOST=0.0.0.0
PORT=4288
LOG_LEVEL=info
WEB_ROOT=/app/web-dist

# The candidate must use session authentication. It may not use PRODUCT_TENANT_ID.
PRODUCT_AUTH_MODE=session
PRODUCT_PUBLIC_ORIGIN=https://REPLACE_WITH_ISOLATED_CANDIDATE_DOMAIN
PRODUCT_SESSION_COOKIE_NAME=answertravel_candidate_session
PRODUCT_SESSION_TTL_HOURS=12

POSTGRES_DB=answertravel_v2
POSTGRES_RUNTIME_USER=answertravel_runtime
POSTGRES_RUNTIME_PASSWORD=REPLACE_WITH_EXISTING_RUNTIME_SECRET
REDIS_URL=redis://redis:6379/2

# Optional existing acceptance console. This is a tenant identifier, not a secret.
ACCEPTANCE_TENANT_ID=REPLACE_WITH_APPROVED_TENANT_UUID

# Provider access is not required by the read-only candidate API. Do not add a key
# unless a separately authorized worker or provider operation is being deployed.
SOURCE_FETCH_ALLOWED_DOMAINS=
